# Copy to server/.env (gitignored). Never commit a real key.
# Free-tier key from Google AI Studio (https://aistudio.google.com/apikey). No billing account needed.
GEMINI_API_KEY=
# Primary 3.5 Flash-Lite (fast, verified live), fallback 3.8 Flash. Gemini 2.5 models return 404 for new keys.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Free-tier limits per model, enforced locally (separate per model, not pooled). Set them to what AI Studio shows;
# these defaults are conservative guards, not verified 3.x quotas.
GEMINI_RPM=10
GEMINI_RPD=20
GEMINI_FALLBACK_RPM=5
GEMINI_FALLBACK_RPD=20
# First-reply windows (ms): the primary gets longer (it may be slow but working), the fallback fails fast.
GEMINI_FIRST_CHUNK_TIMEOUT_MS=25000
GEMINI_FALLBACK_FIRST_CHUNK_TIMEOUT_MS=10000
# Gemini 2.5 thinking budget in tokens; 0 = off (lowest latency)
GEMINI_THINKING_BUDGET=0
# Claude (Anthropic API, paid: usage is billed to this key). Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Haiku 5.5, verified live in the acceptance review; claude-sonnet-5 or claude-opus-5 for deeper,
# slower and more expensive answers. Check a model without billed tokens: npm run verify:claude -w server
ANTHROPIC_MODEL=claude-haiku-5-5
# Per-request timeout (ms); the SDK itself retries 429/5xx/overloaded twice with backoff
ANTHROPIC_TIMEOUT_MS=60000
# 0 disables the SDK's automatic retries (each chat round is exactly one billed request)
ANTHROPIC_MAX_RETRIES=2
# Demo mode pacing (ms): labelled Demo steps and a streamed template instead of an instant answer; 0 = off
DEMO_PACE_MS=1500
PORT=3000
# ── Production only (set in the Vercel project, never here): access codes and question quotas ──
# Vercel sets VERCEL=1, which turns them on; locally nothing below is needed and nothing is gated.
# ACCESS_CODE_SECRET=        (≥ 32 characters; generated into the macOS Keychain)
# KV_REST_API_URL=           (Upstash Redis REST, set by the Vercel Marketplace integration)
# KV_REST_API_TOKEN=
# ACCESS_CONTACT=            (optional, appended to the "questions used up" message)
